# Opcjonalna konfiguracja rozszerzonego Monitor VPS.
# Skopiuj ten plik jako:
#   config/modules/system-monitor.env
# i ustaw prawa tak, aby plik był czytelny tylko dla użytkownika PHP/www-data.
#
# Nie zapisuj prawdziwych haseł w repozytorium.

# Dane infrastruktury są cięższe niż metryki live, dlatego są cache'owane.
SYSTEM_MONITOR_CACHE_TTL=600

# Maksymalna liczba plików analizowana w pojedynczym katalogu i łączny budżet czasu.
SYSTEM_MONITOR_SCAN_MAX_FILES=75000
SYSTEM_MONITOR_SCAN_BUDGET_MS=2500

# Katalogi uwzględniane w wykresie zajętości dysku.
# Format: Etykieta=/ścieżka;Etykieta=/ścieżka
# Jeżeli wartość jest pusta, moduł użyje bezpiecznych wartości domyślnych.
SYSTEM_MONITOR_STORAGE_PATHS="WWW=/var/www;MariaDB=/var/lib/mysql;PostgreSQL=/var/lib/postgresql;Logi=/var/log;Docker=/var/lib/docker;Minecraft=/home/debian/server"

# Cleaner logów NIE jest konfigurowany w miniPORTAL.
# Operacje uprzywilejowane wykonuje Node Agent po Unix Socket, a allowlista
# katalogów, limity i zasady journald muszą być konfigurowane po stronie agenta.

# MariaDB / MySQL
# Jeżeli MYSQL_MONITOR_DSN jest puste, moduł próbuje użyć istniejącego połączenia
# miniPORTAL. Dedykowane konto read-only jest potrzebne, jeżeli chcesz widzieć
# również bazy niewidoczne dla użytkownika DB miniPORTAL.
MYSQL_MONITOR_DSN=""
MYSQL_MONITOR_USER=""
MYSQL_MONITOR_PASSWORD=""

# Przykład:
# MYSQL_MONITOR_DSN="mysql:host=127.0.0.1;port=3306;charset=utf8mb4"
# MYSQL_MONITOR_USER="miniportal_monitor"
# MYSQL_MONITOR_PASSWORD="CHANGE_ME"

# PostgreSQL
# miniPORTAL nie zakłada automatycznie danych dostępowych do osobnego serwera
# PostgreSQL. Aby włączyć statystyki PostgreSQL, skonfiguruj lokalne konto
# tylko do odczytu i uzupełnij poniższe wartości.
POSTGRES_MONITOR_DSN=""
POSTGRES_MONITOR_USER=""
POSTGRES_MONITOR_PASSWORD=""

# Przykład:
# POSTGRES_MONITOR_DSN="pgsql:host=127.0.0.1;port=5432;dbname=postgres;connect_timeout=3"
# POSTGRES_MONITOR_USER="miniportal_monitor"
# POSTGRES_MONITOR_PASSWORD="CHANGE_ME"
