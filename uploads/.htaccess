Options -Indexes

<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

# MediaLibrary publishes sanitized, static SVG documents only.
<IfModule mod_mime.c>
    AddType image/svg+xml .svg
</IfModule>
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/uploads/media/[^/]+[.]svg$#">
        Header set X-Content-Type-Options "nosniff"
        Header set Content-Security-Policy "sandbox; default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'"
    </If>
</IfModule>
