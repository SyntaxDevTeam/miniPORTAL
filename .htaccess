Options -Indexes

# Build Explorer accepts project-scoped application artifacts up to 90 MiB. Keep the PHP transport
# ceiling slightly higher because multipart boundaries and JSON metadata are
# part of the POST body as well.
<IfModule php_module>
    php_value upload_max_filesize 90M
    php_value post_max_size 96M
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot)$">
        <If "%{REQUEST_URI} =~ m#^/templates/shared/assets/vendor/#">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
        <Else>
            Header set Cache-Control "public, max-age=2592000"
        </Else>
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve API credentials when the request is internally routed to index.php.
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    # Public requests may enter through index.php and template assets only.
    RewriteRule ^(?:\.git|\.svn|\.hg)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:bin|cache|config|core|docs|install|installer|modules|tests|theme|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:AGENTS\.md|README\.md|LICENSE|composer\.(?:json|lock)|\.env(?:\..*)?)$ - [F,L,NC]
    RewriteRule ^templates/[^/]+/(?:theme\.php|views)(?:/|$) - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "^microsoft-identity-association(?:\.json)?$">
    Require all granted
    ForceType application/json
    <IfModule mod_headers.c>
        Header set Content-Type "application/json"
    </IfModule>
</FilesMatch>

<FilesMatch "^(?!microsoft-identity-association(?:\.json)?$)(?:\.|.*(?:\.sql|\.ini|\.log|\.ya?ml|\.json|~|\.bak|\.dist)$)">
    Require all denied
</FilesMatch>
